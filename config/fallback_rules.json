  "third_level_fallback": {
    "description": "三级分类兜底：同一三级分类下的商品默认映射到原味",
    "categories": [
      "中式糕点","坚果炒货","蜜饯果干","海味零食","即食蔬菜零食","卤蛋","槟榔",
      "植物蛋白饮料","纯植物油","酱腌菜","冲饮谷物","蜂蜜/蜂蜜制品","婴儿辅食",
      "幼儿特殊医学用途配方粉","肉类制品小食","膨化食品","中式糕点","基础酿造类调味品",
      "基础单一调味品","西式调味酱","罐头食品","速食肠","西式粉面","烘焙原料","杂粮",
      "成人奶粉","学生奶粉","西式冷冻食品","鲜萃/提取类调味品","包装水"


    ]
  },

  "special_flavor_rules": {
    "description": "特殊口味规则：特定类目的特殊口味映射",
    "rules": [
      {
        "category": "辣条",
        "mappings": [
          {"keywords": ["香辣"], "flavor": "香辣味"},
          {"keywords": ["酱香"], "flavor": "酱香味"}
        ],
        "default": "其他"
      },
      {
        "category": "黄豆酱",
        "mappings": [
          {"keywords": ["辣黄豆酱", "辣 黄豆酱"], "flavor": "辣"},
          {"keywords": ["蒜蓉黄豆酱", "蒜蓉 黄豆酱"], "flavor": "蒜蓉"},
          {"keywords": ["酱香"], "flavor": "酱香 / 酱香型"}
        ],
        "default": "原味"
      }
    ]
  },


  "candy_category_rules": {
    "description": "糖果类兜底规则",
    "hard_candy": {
      "default": "水果味",
      "special_mappings": [
        {"keywords": ["薄荷", "清凉", "润喉", "桉叶", "冰爽"], "flavor": "薄荷清凉味"},
        {"keywords": ["陈皮"], "flavor": "陈皮味"},
        {"keywords": ["柠檬"], "flavor": "柠檬味"},
        {"keywords": ["酸梅"], "flavor": "酸梅味"},
        {"keywords": ["山楂"], "flavor": "山楂味"}
      ]
    },
    "soft_candy": {
      "default": "其他",
      "special_mappings": [
        {"keywords": ["话梅", "梅子", "乌梅", "酸梅"], "flavor": "话梅味"},
        {"keywords": ["可乐"], "flavor": "可乐味"}
      ]
    },
    "gum_candy": {
      "default": "其他",
      "special_mappings": [
        {"keywords": ["薄荷", "清凉", "清新", "劲爽"], "flavor": "薄荷清凉类"},
        {"keywords": ["水果"], "flavor": "水果味"}
      ]
    }
  },

  "energy_drink_rules": {
    "description": "能量饮料兜底规则",
    "default": "原味",
    "non_standard_signals": ["人参", "王浆", "枸杞", "玛咖", "瓜拉纳", "肌醇"],
    "fallback_when_signal": "其他"
  },

  "note": "配置说明：\n1. original_flavor_fallback.categories 中的类目会使用原味兜底\n2. special_flavor_rules 中定义了特定类目的特殊口味映射\n3. 新增类目直接添加到 categories 列表中"
}
